# Base de datos.
# En Vercel NO necesitas configurarla: crea la base en Storage → Postgres y
# Vercel inyecta DATABASE_URL automáticamente.
# Localmente (para desarrollo/seed), pega aquí el connection string:
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar las sesiones JWT (usa un valor largo y aleatorio)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Emails (Resend).
# En Vercel: agrega la integración de Resend y RESEND_API_KEY se inyecta sola.
# Si queda vacío, los emails se omiten (la app funciona igual).
RESEND_API_KEY=""
EMAIL_FROM="Citas <onboarding@resend.dev>"

# Zona horaria del negocio (para calcular "hoy" y horarios disponibles)
BUSINESS_TZ="America/Mexico_City"

# Credenciales del admin que crea el seed
ADMIN_EMAIL="admin@demo.com"
ADMIN_PASSWORD="admin123"
